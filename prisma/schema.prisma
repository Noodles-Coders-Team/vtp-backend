// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id          String   @id @default(uuid())
  name        String
  releaseDate DateTime
  link        String?
  recorded    Boolean

  ranks     Rank[]
  gameInfos GameInformation[]
  posts     Post[]

  @@map("game")
}

model GameInformation {
  id        String   @id @default(uuid())
  gameId    String
  discussed Boolean
  canRecord Boolean
  genre     String[] // DBML 'varchar[]' maps to String[]
  tags      String[]
  notes     String?

  game Game @relation(fields: [gameId], references: [id])

  @@map("game_info")
}

model Rank {
  id        String   @id @default(uuid())
  gameId    String
  versionId Int
  date      DateTime
  rank      Float // Kept as 'rank' but mapped to Float; Prisma allows field names matching DBML columns

  game Game @relation(fields: [gameId], references: [id])

  @@map("rank")
}

model Post {
  id              String   @id
  gameId          String
  publicationTime DateTime

  game             Game              @relation(fields: [gameId], references: [id])
  postInformations PostInformation[]

  @@map("post")
}

model PostInformation {
  id          String   @id @default(uuid())
  versionId   Int
  importDate  DateTime
  category    String // Video Shorts or Post, determined on data import
  videoId     String
  videoTitle  String?
  publishTime DateTime
  duration    Int // ==15 - post; < 300 - shorts; > 300 regular video

  engagedViews          Int?
  averageViewDuration   DateTime? @db.Time
  averagePercentage     Float? // average_percentage_viewed_percent
  stayedToWatchPercent  Float?
  uniqueViewers         Int?
  uniqueReach           Int?
  averageViewsPerViewer Float?
  newViewers            Int?
  returningViewers      Int?
  casualViewers         Int?
  regularViewers        Int?

  hypes      Int?
  hypePoints Int?

  subscribersGained Int?
  subscribersLost   Int?

  likes                  Int?
  dislikes               Int?
  likesVsDislikesPercent Float?

  shares        Int?
  commentsAdded Int?

  totalSalesUsd Float?
  orders        Int?

  approvedCommissions Float? // approved_commissions_usd
  pendingCommissions  Float? // pending_commissions_usd
  removedCommission   Float? // removed_commission_usd

  youtubePremiumViews          Int?
  youtubePremiumWatchTimeHours Float? // youtube_premium_watch_time_hours
  playlistWatchTimeHours       Float?
  viewsFromPlaylist            Int?
  viewsPerPlaylistStart        Float?

  hoursStreamed Float?
  remindersSet  Int?

  chatMessages Int?
  reactions    Int?
  remixCount   Int?
  remixViews   Int?

  communityClipViews               Int?
  watchTimeFromCommunityClipsHours Float? // watch_time_from_community_clips_hours

  cardClicks                Int?
  cardsShown                Int?
  clicksPerCardShownPercent Float?

  video Post @relation(fields: [videoId], references: [id]) // "ref: post.id < post_information.video_id"

  @@map("post_info")
}

model ChannelData {
  id    DateTime @id // DBML 'date' as Primary Key mapped to DateTime for standard behavior
  views Int?

  @@map("channel_data")
}

model Users {
  login           String  @id
  userName        String
  permissionLevel String? // Edit & View only?

  @@map("users")
}
